#version 450

#include "common/noise.glsl"
#include "common/grass.glsl"
#include "common/scene_light.glsl"

const int bladesPerAxis = 20;

// Keep in sync with grass::localSizeX in src/include/engine/buffers/compute_buffer.h.
layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Keep in sync with grass::instanceCount in src/include/engine/buffers/compute_buffer.h.
const uint grassInstanceCount = 160000;
const float clumpRadius = 30.0;
const vec3 clumpCenter = vec3(0.0, 0.0, 0.0);

// Keep in sync with numVerticesLOD0 in shaders/grass.vert. A single indirect draw call has
// exactly one vertexCount shared by every instance, so this must always cover the larger
// LOD0 geometry - grass.vert clamps its vertex index back into range for LOD1 instances
// instead of this being varied per instance (which isn't possible for one draw call).
const uint vertexCountLOD0 = 39;

vec2 randomUnit(uint seed)
{
    uint hx = noiseHash(seed * 2654435761u + 1u);
    uint hy = noiseHash(seed * 2654435761u + 0x9e3779b9u);
    return vec2(float(hx), float(hy)) / 4294967296.0;
}

float randomFloat(uint seed, uint saltOffset, float minVal, float maxVal)
{
    float t = float(noiseHash(seed * 2654435761u + saltOffset)) / 4294967296.0;
    return mix(minVal, maxVal, t);
}

void main()
{
    // Only one invocation needs to set these - they're the same for every instance, and
    // writing them from every invocation would race (harmlessly in practice, since they'd
    // all write the same value, but needlessly so).
    if (gl_GlobalInvocationID.x == 0)
    {
        grassData.instanceCount = grassInstanceCount;
        grassData.firstVertex = 0;
        grassData.firstInstance = 0;
        grassData.vertexCount = vertexCountLOD0;
    }

    uint i = gl_GlobalInvocationID.x;
    if (i >= grassInstanceCount)
    {
        return;
    }

    vec2 rand = randomUnit(i);

    // Uniformly sample a disc (sqrt keeps density even instead of bunching points toward
    // the center) for a round clump rather than a square one.
    float angle = rand.x * 6.2831853;
    float radius = sqrt(rand.y) * clumpRadius;
    vec3 offset = vec3(cos(angle) * radius, 0.0, sin(angle) * radius);
    offset.y = sampleHeight(clumpCenter.xz + offset.xz);

    float facingAngle = float(noiseHash(i * 2654435761u + 0x85ebca6bu)) / 4294967296.0 * 6.2831853;

    vec3 position = clumpCenter + offset;
    vec2 facing = vec2(cos(facingAngle), sin(facingAngle));
    float height = randomFloat(i, 0x27d4eb2fu, 0.7, 1.3);
    float width = randomFloat(i, 0x165667b1u, 0.1, 0.12);
    float tilt = randomFloat(i, 0xd3a2646cu, radians(50.0), radians(70.0));
    float bend = 0.5; // unused so far

    float dist = length(camera.position.xyz - position);
    int lodLevel = dist > 10 ? 1 : 0;

    grassInstanceBuffer.grassInstanceData[i].position = position;
    grassInstanceBuffer.grassInstanceData[i].facing = facing;
    grassInstanceBuffer.grassInstanceData[i].height = height;
    grassInstanceBuffer.grassInstanceData[i].width = width;
    grassInstanceBuffer.grassInstanceData[i].tilt = tilt;
    grassInstanceBuffer.grassInstanceData[i].bend = bend;
    grassInstanceBuffer.grassInstanceData[i].lod = lodLevel;
}