#version 450

#include "common/noise.glsl"
#include "common/grass.glsl"

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

const uint grassInstanceCount = 10000;
const float clumpRadius = 10.0;
const vec3 clumpCenter = vec3(0.0, 0.0, 0.0);

vec2 randomUnit(uint seed)
{
    uint hx = noiseHash(seed * 2654435761u + 1u);
    uint hy = noiseHash(seed * 2654435761u + 0x9e3779b9u);
    return vec2(float(hx), float(hy)) / 4294967296.0;
}

void main()
{
    grassData.vertexCount = 39;
    grassData.instanceCount = grassInstanceCount;
    grassData.firstVertex = 0;
    grassData.firstInstance = 0;

    for (uint i = 0; i < grassInstanceCount; ++i)
    {
        vec2 rand = randomUnit(i);

        // Uniformly sample a disc (sqrt keeps density even instead of bunching points toward
        // the center) for a round clump rather than a square one.
        float angle = rand.x * 6.2831853;
        float radius = sqrt(rand.y) * clumpRadius;
        vec3 offset = vec3(cos(angle) * radius, 0.0, sin(angle) * radius);
        offset.y = sampleHeight(clumpCenter.xz + offset.xz);

        float facingAngle = float(noiseHash(i * 2654435761u + 0x85ebca6bu)) / 4294967296.0 * 6.2831853;

        grassInstanceBuffer.grassInstanceData[i].position = clumpCenter + offset;
        grassInstanceBuffer.grassInstanceData[i].facing = vec2(cos(facingAngle), sin(facingAngle));
    }
}